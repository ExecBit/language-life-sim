# Godot binaries must never be line-ending normalised.
*.glb binary
*.bin binary
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.ttf binary

# Godot text resources keep LF.
*.gltf text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.svg text eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.godot text eol=lf
*.json text eol=lf
*.dialogue text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
