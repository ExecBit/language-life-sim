extends SceneTree
const Grammar = preload("res://implementations/communication_lab/game/communication/dialogue_resolver.gd")
const Session = preload("res://implementations/communication_lab/game/communication/lab_session.gd")
var failures := 0

func expect(condition: bool, label: String) -> void:
	if condition:
		print("PASS ISSUE65: ", label)
	else:
		failures += 1
		push_error("FAIL ISSUE65: " + label)

func _initialize() -> void:
	var positive = Grammar.parse("Ich kann dir helfen.", {})
	var negative = Grammar.parse("Ich kann dir nicht helfen.", {})
	expect(positive.status == "RECOGNIZED" and positive.intent == "OFFER_HELP" and positive.frame.actor == "player" and positive.frame.recipient == "astera" and positive.frame.polarity == "positive", "modal help offer keeps player-to-Astera roles and positive polarity")
	expect(negative.status == "RECOGNIZED" and negative.intent == "PLAYER_CANNOT_HELP" and negative.frame.polarity == "negative", "negated offer is not promoted as an offer")
	var request = Grammar.parse("Kannst du mir helfen?", {})
	var offer = Grammar.parse("Kann ich dir helfen?", {})
	expect(request.intent == "REQUEST_HELP" and request.frame.actor == "astera" and request.frame.recipient == "player", "subject and object distinguish request from offer")
	expect(offer.intent == "OFFER_HELP" and offer.frame.actor == "player" and offer.frame.recipient == "astera", "first-person subject distinguishes offer")
	var fragment_offer = Grammar.parse("ich dir helfen", {})
	var ambiguous = Grammar.parse("ich mochtest helfe du", {})
	var fragment_request = Grammar.parse("du mir helfen?", {})
	var unmarked_request = Grammar.parse("du mir helfen.", {})
	expect(fragment_offer.status == "RECOGNIZED" and fragment_offer.intent == "OFFER_HELP" and fragment_offer.recovery_used, "omitted modality recovers an unambiguous role-marked fragment")
	expect(ambiguous.status == "NEEDS_CLARIFICATION", "conflicting nominative roles request clarification")
	expect(fragment_request.status == "RECOGNIZED" and fragment_request.intent == "REQUEST_HELP" and fragment_request.frame.actor == "astera", "question punctuation resolves a reverse-role request")
	expect(unmarked_request.status == "NEEDS_CLARIFICATION" and unmarked_request.frame.actor == "astera" and unmarked_request.frame.recipient == "player", "same roles remain explicit when speech act is unmarked")
	var player_mood = Grammar.parse("Ich bin müde.", {})
	var npc_mood = Grammar.parse("Du bist müde.", {})
	var wrong_agreement = Grammar.parse("Du bin müde.", {})
	var questioned_wrong_case = Grammar.parse("Ich frage du: Wie geht's?", {})
	expect(player_mood.intent == "PLAYER_MOOD_LOW" and npc_mood.intent == "ASTERA_MOOD_LOW", "subject morphology distinguishes speaker mood from NPC mood")
	expect(wrong_agreement.status == "RECOGNIZED" and wrong_agreement.intent == "ASTERA_MOOD_LOW" and "AGREEMENT_MISMATCH" in wrong_agreement.diagnostics, "agreement error is diagnosed while clear subject meaning is retained")
	expect(questioned_wrong_case.intent == "ASK_MOOD" and questioned_wrong_case.frame.actor == "astera" and "PRONOUN_CASE" in questioned_wrong_case.diagnostics, "embedded question preserves its addressee despite a case error")
	var not_good = Grammar.parse("Nicht gut.", {})
	var very_good = Grammar.parse("Sehr gut!", {})
	expect(not_good.intent == "PLAYER_MOOD_LOW" and not_good.frame.polarity == "negative" and very_good.intent == "PLAYER_MOOD_GOOD", "polarity distinguishes negative and positive adjective fragments")
	var unknown = Grammar.parse("ich xyz helfen", {})
	expect(unknown.status == "UNKNOWN" and "xyz" in unknown.unknown_tokens, "significant unknown word is not fuzzy-guessed")
	var unprompted_name = Grammar.parse("Alex.", {})
	var prompted_name = Grammar.parse("Alex.", {"pending_question":"player_name"})
	var unknown_state = Grammar.parse("Ich bin erschöpft.", {})
	expect(unprompted_name.status == "NEEDS_CLARIFICATION" and prompted_name.intent == "PLAYER_NAME", "capitalized names depend on an actual pending name question")
	expect(unknown_state.status == "UNKNOWN", "unknown predicate after copula is not misclassified as a name")
	var no_context_why = Grammar.parse("Warum?", {})
	var contextual_why = Grammar.parse("Warum?", {"topic":"astera_mood","last_npc_line":"Ich bin müde."})
	var no_context_reciprocal = Grammar.parse("Und du?", {})
	var contextual_reciprocal = Grammar.parse("Und du?", {"topic":"player_mood"})
	expect(no_context_why.status == "NEEDS_CLARIFICATION" and contextual_why.intent == "WHY", "elliptic why depends on a relevant topic")
	expect(no_context_reciprocal.status == "NEEDS_CLARIFICATION" and contextual_reciprocal.intent == "ASK_BACK", "reciprocal question depends on a relevant topic")
	var compound_context = Session.initial_context()
	var compound = Session.submit("Ich bin müde und ich arbeite.", compound_context)
	expect(compound.parse.status == "UNSUPPORTED" and compound.parse.semantic_frames.size() == 2 and not compound.objective_progress.share_self, "clear multiple intents retain component frames without partial execution")
	expect(not Grammar.translation_for("Möchtest du mir helfen oder brauchst du Hilfe?").is_empty() and not Grammar.translation_for("Möchtest du, dass ich dir helfe?").is_empty() and not Grammar.translation_for("Was soll ich wiederholen?").is_empty(), "new clarification and fallback utterances have F1 phrase translations")
	var negated_session_context = Session.initial_context()
	var negated_session = Session.submit("Ich kann nicht helfen.", negated_session_context)
	expect(not negated_session.objective_progress.offer_help and not negated_session_context.offered_help, "negation cannot advance the offer objective")
	print("ISSUE65_TARGETED_TESTS: %d failure(s)" % failures)
	quit(1 if failures else 0)

