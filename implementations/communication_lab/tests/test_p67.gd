extends SceneTree
const Session = preload("res://implementations/communication_lab/game/communication/lab_session.gd")
const DialogueLanguage = preload("res://implementations/communication_lab/game/communication/dialogue_language.gd")
var failures := 0

func _initialize() -> void:
	call_deferred("run")

func check(ok: bool, label: String) -> void:
	if ok:
		print("PASS ", label)
	else:
		failures += 1
		push_error("FAIL " + label)

func run() -> void:
	for choice in ["request_help", "offer_help"]:
		for confirm in [true, false]:
			var conflict_context := Session.initial_context()
			Session.submit("Ich bin Neral", conflict_context)
			Session.select_action(choice, conflict_context)
			var utterance := "ich helfe dir" if choice == "request_help" else "Kannst du mir helfen?"
			var actual_intent := "OFFER_HELP" if choice == "request_help" else "REQUEST_HELP"
			var conflict := Session.submit(utterance, conflict_context)
			check(conflict.parse.intent == actual_intent and conflict.parse.reason == "SELECTED_ACTION_MISMATCH" and conflict.effects.is_empty() and not conflict_context.offered_help and not conflict_context.help_requested and not conflict_context.objective_progress.offer_help, "opposite menu direction preserves meaning and waits for confirmation: " + choice)
			check(conflict.notification.contains("выбрали") and conflict_context.pending_clarification.proposition.intent == actual_intent, "notice explains the mismatch and pending question stores actual meaning")
			var actions := Session.available_actions(conflict_context)
			var meaning := "хотите помочь Астере" if actual_intent == "OFFER_HELP" else "просите помощи у Астеры"
			check(actions[0].label == "Подтвердить, что " + meaning and actions[1].label == "Отрицать, что " + meaning, "clarification labels explain the actual help direction")
			var answer := Session.submit("Ja" if confirm else "Nein", conflict_context)
			var expected_effect := "offer_help_to_astera" if actual_intent == "OFFER_HELP" else "request_help_from_astera"
			check(answer.effects == ([expected_effect] if confirm else []) and conflict_context.pending_clarification.is_empty(), "confirmation or denial controls the actual proposition")
	var matching_choice := Session.initial_context()
	Session.submit("Ich bin Neral", matching_choice)
	Session.select_action("request_help", matching_choice)
	check(Session.submit("Kannst du mir helfen?", matching_choice).effects == ["request_help_from_astera"], "matching request proceeds directly")
	var menu_context := Session.initial_context()
	check(Session.available_actions(menu_context).map(func(a): return a.id) == ["introduce", "share_state", "offer_help"], "opening exposes authored actions rather than grammar profiles")
	Session.submit("Ich bin Neral", menu_context)
	check(menu_context.dialogue_node == "conversation" and not Session.available_actions(menu_context).any(func(a): return a.id == "introduce"), "introduction moves the graph and removes the completed name action")
	var unavailable_before := menu_context.duplicate(true)
	check(not Session.select_action("introduce", menu_context).accepted and menu_context == unavailable_before, "unavailable action cannot be selected or mutate context")
	Session.submit("Ich bin müde", menu_context)
	check(menu_context.dialogue_node == "after_tired" and Session.available_actions(menu_context).any(func(a): return a.id == "request_help"), "tiredness reaches an authored continuation with a help request")
	Session.select_action("request_help", menu_context)
	Session.submit("Kannst du mir helfen?", menu_context)
	check(menu_context.dialogue_node == "after_request" and not Session.available_actions(menu_context).any(func(a): return a.id == "request_help"), "request changes available continuations")
	var menu_clarification := Session.initial_context()
	Session.submit("ich helfen", menu_clarification, "help")
	check(Session.available_actions(menu_clarification).map(func(a): return a.id) == ["confirm", "reject", "back"], "clarification exposes confirmation choices and navigation")
	Session.select_action("confirm", menu_clarification)
	Session.submit("Ja", menu_clarification)
	check(menu_clarification.dialogue_node == "after_offer" and not Session.available_actions(menu_clarification).any(func(a): return a.id == "confirm"), "confirmation transitions to the resulting authored node")
	Session.submit("ich helfen", menu_clarification)
	check(Session.select_action("back", menu_clarification).closed_clarification and menu_clarification.pending_clarification.is_empty() and Session.submit("Ja", menu_clarification).effects.is_empty(), "return to topics expires the confirmation target")
	Session.close_dialog(menu_context)
	Session.opening_line(menu_context)
	check(menu_context.dialogue_node == "after_request" and not Session.available_actions(menu_context).any(func(a): return a.id == "introduce"), "reopening keeps the conversation node and completed name slot")
	Session.reset(menu_context)
	check(menu_context.dialogue_node == "opening" and Session.available_actions(menu_context)[0].id == "introduce", "reset restores the opening node")
	var name_context := Session.initial_context()
	check(name_context.awaiting_name and name_context.pending_question == "player_name", "opening context asks for a name")
	var tired_before_name := Session.submit("Ich bin müde", name_context)
	check(tired_before_name.parse.intent == "REPORT_STATE" and name_context.player_name.is_empty() and name_context.awaiting_name, "state report during name slot is not saved as a name")
	var saved_name := Session.submit("Ich heiße Neral", name_context)
	check(saved_name.parse.intent == "PLAYER_NAME" and name_context.player_name == "Neral" and not name_context.awaiting_name, "arbitrary name is accepted through the initial name form")
	var reopened := Session.opening_line(name_context)
	check(reopened.answer.contains("Neral") and not name_context.awaiting_name, "name survives reopening")
	Session.close_dialog(name_context)
	var outside_name := Session.submit("Ich bin Mira", name_context)
	check(outside_name.parse.reason == "NAME_SLOT_CLOSED" and name_context.player_name == "Neral", "name form cannot replace a name after the initial slot")
	var outside_negative_name := Session.submit("Ich bin nicht Mira", name_context)
	check(outside_negative_name.parse.reason == "NAME_SLOT_CLOSED" and outside_negative_name.effects.is_empty() and name_context.player_name == "Neral", "negated name is also blocked after the initial slot")
	var bare_name := Session.submit("Mira", name_context)
	check(bare_name.parse.reason == "NAME_SLOT_CLOSED" and name_context.player_name == "Neral", "one-word name is rejected after the initial slot")
	Session.reset(name_context)
	check(name_context.awaiting_name and name_context.player_name.is_empty(), "reset reopens the initial name slot")
	var bare_first_name := Session.submit("Neral", name_context)
	check(bare_first_name.parse.intent == "PLAYER_NAME" and name_context.player_name == "Neral", "one-word name is accepted in the initial slot")
	var negative_name_context := Session.initial_context()
	var negative_name := Session.submit("Ich bin nicht Neral", negative_name_context)
	check(negative_name.parse.intent == "NEGATED_NAME" and negative_name.effects.is_empty() and negative_name_context.player_name.is_empty(), "negated introduction does not save a name")

	var state_context := Session.initial_context()
	var tired := Session.submit("Ich bin müde", state_context)
	var happy := Session.submit("Ich bin glücklich", state_context)
	check(tired.parse.intent == "REPORT_STATE" and tired.answer == "Oh… Das tut mir leid. Ruh dich aus!" and state_context.player_mood == "happy", "tired and happy state forms select distinct data-driven responses")
	check(happy.answer == "Oh, wie schön! Das freut mich!" and state_context.last_player_state.state_id == "happy", "last player state is remembered")
	var ellipsis := Session.submit("ich müde", Session.initial_context())
	check(ellipsis.parse.intent == "REPORT_STATE" and ellipsis.parse.diagnostics.any(func(d): return d.get("code", "") == "OMITTED_COPULA"), "beginner ellipsis is understood with a grammar diagnostic")
	var astera_context := Session.initial_context()
	var astera_state := Session.submit("Du bist müde", astera_context)
	check(astera_state.parse.intent == "REPORT_ASTERA_STATE" and astera_context.astera_mood == "tired" and astera_context.player_mood.is_empty(), "Du assigns the state to Astera")
	var negative_state := Session.submit("Ich bin nicht müde", state_context)
	check(negative_state.parse.frame.polarity == "negative" and state_context.player_mood.is_empty() and state_context.last_player_state.state_id == "tired", "negated tiredness does not infer happiness")
	var subjectless_negative_context := Session.initial_context()
	var subjectless_negative := Session.submit("nicht müde", subjectless_negative_context)
	check(subjectless_negative.parse.reason == "MISSING_EXPERIENCER" and subjectless_negative_context.pending_clarification.proposition.polarity == "negative", "subjectless negation keeps its polarity through clarification")
	check(Session.available_actions(subjectless_negative_context)[0].label.contains("не уставший"), "negative state clarification label preserves negation")
	var subjectless_negative_yes := Session.submit("Ja", subjectless_negative_context)
	check(subjectless_negative_yes.effects == ["player_state:tired:negative"] and subjectless_negative_context.player_mood.is_empty(), "confirming a negative state does not become a positive state")
	var new_state := Session.submit("Ich bin nervös", Session.initial_context())
	check(new_state.parse.intent == "REPORT_STATE" and new_state.answer == "Das kenne ich. Wir können langsam sprechen.", "adding a compatible state in data requires no parser branch")

	for utterance in ["jetzt ich bin müde", "ich bin sehr müde", "ich bin blorple müde", "ich bin müde jetzt", "ich müde bin"]:
		var context := Session.initial_context()
		var result := Session.submit(utterance, context)
		check(result.parse.status in ["UNKNOWN", "UNSUPPORTED"] and result.effects.is_empty() and context.player_mood.is_empty(), "unsupported state continuation has no effect: " + utterance)
	var multi_state_context := Session.initial_context()
	var multi_state := Session.submit("Ich bin müde und glücklich", multi_state_context)
	check(multi_state.parse.status == "UNSUPPORTED" and multi_state.effects.is_empty() and multi_state_context.player_mood.is_empty(), "two state values do not partially apply")
	var multi_intent_context := Session.initial_context()
	var multi_intent := Session.submit("Ich bin müde. Ich bin glücklich.", multi_intent_context)
	check(multi_intent.parse.reason == "MULTIPLE_INTENTS" and multi_intent.effects.is_empty(), "separate intents are rejected as a whole")

	var offer_context := Session.initial_context()
	var offer := Session.submit("Kann ich dir helfen?", offer_context)
	check(offer.parse.intent == "OFFER_HELP" and offer_context.offered_help and offer.effects == ["offer_help_to_astera"], "explicit player-to-Astera help offer is applied once")
	var repeated_offer := Session.submit("Kann ich dir helfen?", offer_context)
	check(repeated_offer.effects.is_empty() and offer_context.offered_help, "repeated offer does not apply its effect twice")
	var request_context := Session.initial_context()
	request_context.selected_topic = "player_mood"
	var request := Session.submit("Kannst du mir helfen?", request_context)
	check(request.parse.intent == "REQUEST_HELP" and request_context.help_requested and request.effects == ["request_help_from_astera"], "explicit Astera-to-player help request follows meaning across menu topics")
	var refusal_context := Session.initial_context()
	var refusal := Session.submit("Ich kann dir nicht helfen", refusal_context)
	check(refusal.parse.intent == "PLAYER_CANNOT_HELP" and refusal.effects.is_empty() and not refusal_context.offered_help, "negated help cannot trigger a positive offer")
	var role_fragment := Session.submit("ich dir helfen", Session.initial_context())
	check(role_fragment.parse.intent == "OFFER_HELP" and role_fragment.effects == ["offer_help_to_astera"], "explicit pronoun roles support a short help fragment")
	var incomplete_refusal_context := Session.initial_context()
	var incomplete_refusal := Session.submit("Ich kann nicht helfen", incomplete_refusal_context)
	var refusal_yes := Session.submit("Ja", incomplete_refusal_context)
	check(incomplete_refusal.parse.frame.polarity == "negative" and incomplete_refusal_context.pending_clarification.is_empty() and refusal_yes.effects.is_empty(), "negative help without a recipient cannot be confirmed as a positive offer")

	var clarify_context := Session.initial_context()
	var clarify := Session.submit("ich helfen", clarify_context, "help")
	check(clarify.parse.reason == "MISSING_RECIPIENT" and clarify.answer == "Du möchtest mir helfen?" and clarify.notification.contains("кому") and not clarify_context.offered_help, "missing help recipient asks one question and explains the cause")
	var yes := Session.submit("Ja", clarify_context)
	check(yes.parse.intent == "CONFIRM_CLARIFICATION" and yes.effects == ["offer_help_to_astera"] and clarify_context.offered_help, "yes applies the single pending proposition without rewriting the sentence")
	var second_yes := Session.submit("Ja", clarify_context)
	check(second_yes.parse.reason == "NO_OPEN_YES_NO_TARGET" and second_yes.effects.is_empty(), "a second yes has no old proposition to apply")
	var no_context := Session.initial_context()
	Session.submit("ich helfen", no_context, "help")
	var no := Session.submit("Nein", no_context)
	check(no.parse.intent == "REJECT_CLARIFICATION" and no.effects.is_empty() and not no_context.offered_help, "no rejects the pending offer without changing help state")
	var stale_context := Session.initial_context()
	Session.submit("ich helfen", stale_context, "help")
	var topic_change := Session.select_topic("player_mood", stale_context)
	var stale_yes := Session.submit("Ja", stale_context)
	check(topic_change.closed_clarification and stale_yes.effects.is_empty() and not stale_context.offered_help, "changing topic cancels the pending yes/no target")
	var close_context := Session.initial_context()
	Session.submit("ich helfen", close_context, "help")
	check(Session.close_dialog(close_context) and Session.submit("Ja", close_context).effects.is_empty(), "closing dialogue cancels the pending yes/no target")
	var fresh_message_context := Session.initial_context()
	Session.submit("ich helfen", fresh_message_context, "help")
	var fresh_message := Session.submit("Ich bin glücklich", fresh_message_context)
	check(fresh_message.parse.intent == "REPORT_STATE" and fresh_message_context.player_mood == "happy" and fresh_message_context.pending_clarification.is_empty(), "a new full message expires the old clarification before applying its own meaning")
	var no_pending := Session.submit("Ja", Session.initial_context())
	check(no_pending.parse.reason == "NO_OPEN_YES_NO_TARGET" and no_pending.effects.is_empty(), "yes without an open question has no side effect")
	var unknown_help_context := Session.initial_context()
	var unknown_help := Session.submit("Ich kann dir nicht blorple helfen", unknown_help_context)
	check(unknown_help.parse.status == "UNKNOWN" and unknown_help.parse.unknown_tokens.has("blorple") and unknown_help.effects.is_empty(), "unknown help token remains visible and cannot be swallowed")
	var compound_context := Session.initial_context()
	var compound := Session.submit("Kann ich dir helfen? Ich bin müde.", compound_context)
	check(compound.parse.reason == "MULTIPLE_INTENTS" and compound.effects.is_empty(), "multiple help and state intents cannot partially apply")
	check(DialogueLanguage.translation_for("Kann ich dir helfen?") != "" and DialogueLanguage.translation_for("Ich bin …") != "", "F1 source data contains reusable constructions")

	print("P67_TESTS: %d failure(s)" % failures)
	quit(1 if failures > 0 else 0)
