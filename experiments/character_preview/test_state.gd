extends SceneTree
const State = preload("res://experiments/character_preview/prototype_state.gd")

func _init() -> void:
	var accepted = State.new()
	assert(not accepted.commit("invalid", "give"))
	assert(accepted.commit("answer", "accept"))
	assert(not accepted.commit("answer", "accept"))
	assert(not accepted.commit("other", "decline"))
	assert(accepted.cup_location == "player")
	assert(accepted.commit("return", "give"))
	assert(not accepted.commit("return-again", "give"))
	assert(accepted.cup_location == "lena")
	assert(accepted.commit("question", "identify"))
	assert(not accepted.commit("question", "identify"))
	var restored = State.new()
	assert(restored.restore(JSON.parse_string(JSON.stringify(accepted.snapshot()))))
	assert(restored.cup_location == "lena" and restored.identified)
	assert(not restored.commit("return", "give"))
	assert(restored.units.size() == 3)
	var declined = State.new()
	assert(declined.commit("no", "decline"))
	assert(declined.cup_location == "table")
	assert(declined.commit("take1", "take"))
	assert(not declined.commit("take2", "take"))
	assert(declined.commit("place1", "place"))
	assert(declined.cup_location == "table")
	assert(not declined.commit("place2", "place"))
	var before: Dictionary = declined.snapshot()
	assert(not declined.restore({"version": 999}))
	assert(declined.snapshot() == before)
	print("LANGUAGE_LIFE_STATE_TESTS_OK")
	quit()
